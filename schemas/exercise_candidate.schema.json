{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-teacher.local/schemas/exercise_candidate.schema.json",
  "title": "C++ Teacher Exercise Candidate Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_schema_version",
    "exercise",
    "files"
  ],
  "properties": {
    "candidate_schema_version": {
      "const": 1
    },
    "generation_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "exercise": {
      "$ref": "#/$defs/exercise"
    },
    "files": {
      "type": "object",
      "description": "Hidden artifact contents keyed by their final project-relative path.",
      "propertyNames": {
        "pattern": "^(tests|support|analysis_support)/[A-Za-z0-9_./-]+\\.(cpp|hpp)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "conceptCheck": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "non_const_reference_parameter",
            "const_reference_parameter",
            "non_const_reference_variable",
            "const_reference_variable",
            "std_move_initializer",
            "virtual_destructor",
            "copy_constructor",
            "move_constructor"
          ]
        },
        "function": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "argument": {
          "type": "string"
        },
        "class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "exercise_schema_version",
        "id",
        "topic",
        "title",
        "difficulty",
        "type",
        "scenario",
        "problem_statement",
        "constraints",
        "learning_objective",
        "learner_goal",
        "instructions",
        "starter_code",
        "reference_solution",
        "expected_concepts",
        "hidden_test_file",
        "hints",
        "explanation"
      ],
      "properties": {
        "exercise_schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "type": {
          "enum": [
            "fix_code",
            "implement_code",
            "debug_code"
          ]
        },
        "scenario": {
          "type": "string",
          "minLength": 60
        },
        "problem_statement": {
          "type": "string",
          "minLength": 80
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "learning_objective": {
          "type": "string",
          "minLength": 30
        },
        "instructions": {
          "type": "string",
          "minLength": 40
        },
        "starter_code": {
          "type": "string",
          "minLength": 20
        },
        "reference_solution": {
          "type": "string",
          "minLength": 20
        },
        "expected_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "concept_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conceptCheck"
          }
        },
        "hidden_test_file": {
          "type": "string",
          "pattern": "^tests/[A-Za-z0-9_./-]+\\.cpp$"
        },
        "support_file": {
          "type": "string",
          "pattern": "^support/[A-Za-z0-9_./-]+\\.hpp$"
        },
        "analysis_support_file": {
          "type": "string",
          "pattern": "^analysis_support/[A-Za-z0-9_./-]+\\.hpp$"
        },
        "trace_mode": {
          "enum": [
            "runtime",
            "runtime_derived_raii",
            "source_pattern"
          ]
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 40
        },
        "learner_goal": {
          "type": "string",
          "minLength": 30
        }
      }
    }
  }
}
